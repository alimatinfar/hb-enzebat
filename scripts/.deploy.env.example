# تنظیمات دیپلوی — این فایل را روی سرور کنار پروژه بسازید:
#   /var/www/hb-enzebat/.deploy.env
# (در گیت نیست؛ فقط روی سرور زندگی می‌کند)

# شاخه‌ای که دیپلوی می‌شود
BRANCH=master

# نام یا id پروسه در pm2 (خروجی pm2 list)
PM2_APP=1

# آدرس بررسی سلامت بعد از ری‌استارت (خالی = رد شود).
# اگر اپ روی پورت 3000 است:
# HEALTH_URL=http://127.0.0.1:3000
HEALTH_URL=

# تعداد بکاپ‌هایی که نگه داشته می‌شود
BACKUP_KEEP=10
