# codebase-memory ignore rules (gitignore-style). Keep the graph small and relevant:
# generated / vendored / build output is never queried by an agent.

# Prisma client generated by `prisma generate` (gitignored too) — hand-editing is forbidden anyway
app/generated/
lib/generated/

# build + dependency output
.next/
out/
build/
node_modules/

# lockfiles / generated type stubs / build info
package-lock.json
next-env.d.ts
tsconfig.tsbuildinfo
